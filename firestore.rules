rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'yoeur.man2010@gmail.com'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'avatar', 'inviteCode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role is string && data.role in ['student', 'instructor', 'admin']
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('inviteCode' in data) || isValidId(data.inviteCode))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvitation(data) {
      return data.keys().hasAll([
          'id', 'code', 'email', 'fullName', 'role', 'assignedCourseIds',
          'cohortOrSpecialty', 'status', 'invitedByUid', 'invitedByName',
          'invitedByEmail', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'code', 'email', 'fullName', 'role', 'assignedCourseIds',
          'cohortOrSpecialty', 'subscriptionTier', 'welcomeNote', 'status',
          'invitedByUid', 'invitedByName', 'invitedByEmail', 'acceptedByUid',
          'acceptedAt', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.code is string && data.code.size() >= 6 && data.code.size() <= 64 && data.code.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.fullName is string && data.fullName.size() <= 120
        && data.role is string && data.role in ['instructor', 'student']
        && data.assignedCourseIds is list && data.assignedCourseIds.size() <= 20
        && (data.assignedCourseIds.size() == 0 || data.assignedCourseIds[0] is string)
        && data.cohortOrSpecialty is string && data.cohortOrSpecialty.size() <= 120
        && (!('subscriptionTier' in data) || (data.subscriptionTier is string && data.subscriptionTier in ['free', 'pro', 'expert', 'enterprise']))
        && (!('welcomeNote' in data) || (data.welcomeNote is string && data.welcomeNote.size() <= 500))
        && data.status is string && data.status in ['pending', 'accepted', 'revoked']
        && isValidId(data.invitedByUid)
        && data.invitedByName is string && data.invitedByName.size() >= 1 && data.invitedByName.size() <= 120
        && data.invitedByEmail is string && data.invitedByEmail.size() >= 3 && data.invitedByEmail.size() <= 254
        && (!('acceptedByUid' in data) || isValidId(data.acceptedByUid))
        && (!('acceptedAt' in data) || (data.acceptedAt is string && data.acceptedAt.size() <= 64))
        && data.expiresAt is string && data.expiresAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidInstructorInvite(inviteCode) {
      return isValidId(inviteCode)
        && exists(/databases/$(database)/documents/invitations/$(inviteCode))
        && get(/databases/$(database)/documents/invitations/$(inviteCode)).data.role == 'instructor'
        && get(/databases/$(database)/documents/invitations/$(inviteCode)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/invitations/$(inviteCode)).data.status == 'pending';
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (
          incoming().role == 'student' ||
          isAdmin() ||
          (incoming().role == 'instructor' && ('inviteCode' in incoming()) && hasValidInstructorInvite(incoming().inviteCode))
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    match /invitations/{inviteId} {
      allow get: if isValidId(inviteId) && (isAdmin() || (isVerified() && existing().email == request.auth.token.email));
      allow list: if isAdmin() || (isVerified() && resource.data.email == request.auth.token.email);

      allow create: if isValidId(inviteId)
        && isAdmin()
        && isValidInvitation(incoming())
        && incoming().id == inviteId
        && incoming().invitedByUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(inviteId)
        && isVerified()
        && isValidInvitation(incoming())
        && incoming().id == existing().id
        && incoming().code == existing().code
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().invitedByUid == existing().invitedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status == 'pending'
            && existing().email == request.auth.token.email
            && incoming().status == 'accepted'
            && incoming().acceptedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'acceptedAt', 'updatedAt'])
          )
        );

      allow delete: if isValidId(inviteId) && isAdmin();
    }

    function isValidCoursePayment(data) {
      return data.keys().hasAll([
          'id', 'transactionId', 'invoiceNumber', 'studentUid', 'studentName',
          'studentEmail', 'courseId', 'courseCode', 'courseTitle',
          'originalPrice', 'discountAmount', 'amountPaid', 'currency',
          'paymentMethod', 'status', 'paidAt', 'accessStartDate',
          'accessExpiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'transactionId', 'invoiceNumber', 'studentUid', 'studentName',
          'studentEmail', 'courseId', 'courseCode', 'courseTitle',
          'originalPrice', 'discountAmount', 'amountPaid', 'currency',
          'promoCode', 'paymentMethod', 'cardLast4', 'status', 'paidAt',
          'accessStartDate', 'accessExpiresAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.transactionId is string && data.transactionId.size() >= 4 && data.transactionId.size() <= 64
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 4 && data.invoiceNumber.size() <= 64
        && isValidId(data.studentUid)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 254
        && isValidId(data.courseId)
        && data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 64
        && data.courseTitle is string && data.courseTitle.size() >= 1 && data.courseTitle.size() <= 200
        && data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 50000
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= data.originalPrice
        && data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= data.originalPrice
        && data.currency is string && data.currency == 'USD'
        && (!('promoCode' in data) || (data.promoCode is string && data.promoCode.size() <= 40))
        && data.paymentMethod is string && data.paymentMethod in ['card', 'paypal', 'bank_transfer']
        && (!('cardLast4' in data) || (data.cardLast4 is string && data.cardLast4.size() <= 8))
        && data.status is string && data.status in ['paid', 'refunded']
        && data.paidAt is string && data.paidAt.size() >= 8 && data.paidAt.size() <= 64
        && data.accessStartDate is string && data.accessStartDate.size() >= 8 && data.accessStartDate.size() <= 32
        && data.accessExpiresAt is string && data.accessExpiresAt.size() >= 8 && data.accessExpiresAt.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /coursePayments/{paymentId} {
      allow get: if isValidId(paymentId) && (
        isAdmin() ||
        (isVerified() && existing().studentUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isVerified() && resource.data.studentUid == request.auth.uid);

      allow create: if isValidId(paymentId)
        && isVerified()
        && isValidCoursePayment(incoming())
        && incoming().id == paymentId
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'paid'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(paymentId)
        && isAdmin()
        && isValidCoursePayment(incoming())
        && incoming().id == existing().id
        && incoming().studentUid == existing().studentUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(paymentId) && isAdmin();
    }
  }
}
