rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'yoeur.man2010@gmail.com'
      );
    }

    function isInstructorOrAdmin() {
      return isAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'instructor']
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'avatar', 'inviteCode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role is string && data.role in ['student', 'instructor', 'admin']
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500))
        && (!('inviteCode' in data) || isValidId(data.inviteCode))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvitation(data) {
      return data.keys().hasAll([
          'id', 'code', 'email', 'fullName', 'role', 'assignedCourseIds',
          'cohortOrSpecialty', 'status', 'invitedByUid', 'invitedByName',
          'invitedByEmail', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'code', 'email', 'fullName', 'role', 'assignedCourseIds',
          'cohortOrSpecialty', 'subscriptionTier', 'welcomeNote', 'status',
          'invitedByUid', 'invitedByName', 'invitedByEmail', 'acceptedByUid',
          'acceptedAt', 'expiresAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.code is string && data.code.size() >= 6 && data.code.size() <= 64 && data.code.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.fullName is string && data.fullName.size() <= 120
        && data.role is string && data.role in ['instructor', 'student']
        && data.assignedCourseIds is list && data.assignedCourseIds.size() <= 20
        && (data.assignedCourseIds.size() == 0 || data.assignedCourseIds[0] is string)
        && data.cohortOrSpecialty is string && data.cohortOrSpecialty.size() <= 120
        && (!('subscriptionTier' in data) || (data.subscriptionTier is string && data.subscriptionTier in ['free', 'pro', 'expert', 'enterprise']))
        && (!('welcomeNote' in data) || (data.welcomeNote is string && data.welcomeNote.size() <= 500))
        && data.status is string && data.status in ['pending', 'accepted', 'revoked']
        && isValidId(data.invitedByUid)
        && data.invitedByName is string && data.invitedByName.size() >= 1 && data.invitedByName.size() <= 120
        && data.invitedByEmail is string && data.invitedByEmail.size() >= 3 && data.invitedByEmail.size() <= 254
        && (!('acceptedByUid' in data) || isValidId(data.acceptedByUid))
        && (!('acceptedAt' in data) || (data.acceptedAt is string && data.acceptedAt.size() <= 64))
        && data.expiresAt is string && data.expiresAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidInstructorInvite(inviteCode) {
      return isValidId(inviteCode)
        && exists(/databases/$(database)/documents/invitations/$(inviteCode))
        && get(/databases/$(database)/documents/invitations/$(inviteCode)).data.role == 'instructor'
        && get(/databases/$(database)/documents/invitations/$(inviteCode)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/invitations/$(inviteCode)).data.status == 'pending';
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (
          incoming().role == 'student' ||
          isAdmin() ||
          (incoming().role == 'instructor' && ('inviteCode' in incoming()) && hasValidInstructorInvite(incoming().inviteCode))
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    match /invitations/{inviteId} {
      allow get: if isValidId(inviteId) && (isAdmin() || (isVerified() && existing().email == request.auth.token.email));
      allow list: if isAdmin() || (isVerified() && resource.data.email == request.auth.token.email);

      allow create: if isValidId(inviteId)
        && isAdmin()
        && isValidInvitation(incoming())
        && incoming().id == inviteId
        && incoming().invitedByUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(inviteId)
        && isVerified()
        && isValidInvitation(incoming())
        && incoming().id == existing().id
        && incoming().code == existing().code
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().invitedByUid == existing().invitedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status == 'pending'
            && existing().email == request.auth.token.email
            && incoming().status == 'accepted'
            && incoming().acceptedByUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'acceptedAt', 'updatedAt'])
          )
        );

      allow delete: if isValidId(inviteId) && isAdmin();
    }

    function isValidCoursePayment(data) {
      return data.keys().hasAll([
          'id', 'transactionId', 'invoiceNumber', 'studentUid', 'studentName',
          'studentEmail', 'courseId', 'courseCode', 'courseTitle',
          'originalPrice', 'discountAmount', 'amountPaid', 'currency',
          'paymentMethod', 'status', 'paidAt', 'accessStartDate',
          'accessExpiresAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'transactionId', 'invoiceNumber', 'studentUid', 'studentName',
          'studentEmail', 'courseId', 'courseCode', 'courseTitle',
          'originalPrice', 'discountAmount', 'amountPaid', 'currency',
          'promoCode', 'paymentMethod', 'cardLast4', 'status', 'paidAt',
          'accessStartDate', 'accessExpiresAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.transactionId is string && data.transactionId.size() >= 4 && data.transactionId.size() <= 64
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 4 && data.invoiceNumber.size() <= 64
        && isValidId(data.studentUid)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 254
        && isValidId(data.courseId)
        && data.courseCode is string && data.courseCode.size() >= 1 && data.courseCode.size() <= 64
        && data.courseTitle is string && data.courseTitle.size() >= 1 && data.courseTitle.size() <= 200
        && data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 50000
        && data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= data.originalPrice
        && data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= data.originalPrice
        && data.currency is string && data.currency == 'USD'
        && (!('promoCode' in data) || (data.promoCode is string && data.promoCode.size() <= 40))
        && data.paymentMethod is string && data.paymentMethod in ['card', 'paypal', 'bank_transfer']
        && (!('cardLast4' in data) || (data.cardLast4 is string && data.cardLast4.size() <= 8))
        && data.status is string && data.status in ['paid', 'refunded']
        && data.paidAt is string && data.paidAt.size() >= 8 && data.paidAt.size() <= 64
        && data.accessStartDate is string && data.accessStartDate.size() >= 8 && data.accessStartDate.size() <= 32
        && data.accessExpiresAt is string && data.accessExpiresAt.size() >= 8 && data.accessExpiresAt.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /coursePayments/{paymentId} {
      allow get: if isValidId(paymentId) && (
        isAdmin() ||
        (isVerified() && existing().studentUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isVerified() && resource.data.studentUid == request.auth.uid);

      allow create: if isValidId(paymentId)
        && isVerified()
        && isValidCoursePayment(incoming())
        && incoming().id == paymentId
        && incoming().studentUid == request.auth.uid
        && incoming().status == 'paid'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(paymentId)
        && isAdmin()
        && isValidCoursePayment(incoming())
        && incoming().id == existing().id
        && incoming().studentUid == existing().studentUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(paymentId) && isAdmin();
    }

    function isValidLabTopology(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'title', 'presetId', 'devices', 'links',
          'deviceCount', 'linkCount', 'objectivesPassed', 'objectivesTotal',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'title', 'presetId', 'devices', 'links',
          'deviceCount', 'linkCount', 'objectivesPassed', 'objectivesTotal',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && isValidId(data.presetId)
        && data.devices is list && data.devices.size() <= 40
        && (data.devices.size() == 0 || data.devices[0] is map)
        && data.links is list && data.links.size() <= 80
        && (data.links.size() == 0 || data.links[0] is map)
        && data.deviceCount is int && data.deviceCount >= 0 && data.deviceCount <= 40 && data.deviceCount == data.devices.size()
        && data.linkCount is int && data.linkCount >= 0 && data.linkCount <= 80 && data.linkCount == data.links.size()
        && data.objectivesPassed is int && data.objectivesPassed >= 0 && data.objectivesPassed <= 50
        && data.objectivesTotal is int && data.objectivesTotal >= 0 && data.objectivesTotal <= 50 && data.objectivesPassed <= data.objectivesTotal
        && (!('status' in data) || (data.status is string && data.status in ['in_progress', 'completed']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /labTopologies/{topologyId} {
      allow get: if isValidId(topologyId)
        && isVerified()
        && isOwner(existing().ownerUid);

      allow list: if isVerified()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(topologyId)
        && isVerified()
        && isValidLabTopology(incoming())
        && incoming().id == topologyId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(topologyId)
        && isVerified()
        && isValidLabTopology(incoming())
        && isOwner(existing().ownerUid)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'presetId', 'devices', 'links',
          'deviceCount', 'linkCount', 'objectivesPassed',
          'objectivesTotal', 'status', 'updatedAt'
        ]);

      allow delete: if isValidId(topologyId)
        && isVerified()
        && isOwner(existing().ownerUid);
    }

    function isValidLearningStreak(data) {
      return data.keys().hasAll([
          'uid', 'activeDates', 'currentStreak', 'longestStreak',
          'lastActiveDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'activeDates', 'currentStreak', 'longestStreak',
          'lastActiveDate', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.activeDates is list
        && data.activeDates.size() <= 365
        && (data.activeDates.size() == 0 || (data.activeDates[0] is string && data.activeDates[0].size() == 10))
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 3650
        && data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 3650
        && data.lastActiveDate is string && data.lastActiveDate.size() <= 16
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /learningStreaks/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidLearningStreak(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidLearningStreak(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'activeDates', 'currentStreak', 'longestStreak', 'lastActiveDate', 'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidStudyGoal(data) {
      return data.keys().hasAll([
          'uid', 'dailyGoalMinutes', 'dateKey', 'courseSeconds',
          'labSeconds', 'practiceSeconds', 'creditedModuleIds',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'dailyGoalMinutes', 'dateKey', 'courseSeconds',
          'labSeconds', 'practiceSeconds', 'creditedModuleIds',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 300
        && data.dateKey is string && data.dateKey.size() == 10
        && data.courseSeconds is int && data.courseSeconds >= 0 && data.courseSeconds <= 86400
        && data.labSeconds is int && data.labSeconds >= 0 && data.labSeconds <= 86400
        && data.practiceSeconds is int && data.practiceSeconds >= 0 && data.practiceSeconds <= 86400
        && data.creditedModuleIds is list
        && data.creditedModuleIds.size() <= 100
        && (data.creditedModuleIds.size() == 0 || (data.creditedModuleIds[0] is string && data.creditedModuleIds[0].size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /studyGoals/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidStudyGoal(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidStudyGoal(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'dailyGoalMinutes', 'dateKey', 'courseSeconds', 'labSeconds',
          'practiceSeconds', 'creditedModuleIds', 'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidPersonalFlashcard(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'courseId', 'category', 'term',
          'question', 'answer', 'masteryStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'courseId', 'courseCode', 'courseTitle',
          'moduleId', 'moduleTitle', 'category', 'term', 'question',
          'answer', 'portNumber', 'transportProtocol', 'osiLayer',
          'explanation', 'memoryTip', 'masteryStatus', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isValidId(data.courseId)
        && (!('courseCode' in data) || (data.courseCode is string && data.courseCode.size() <= 64))
        && (!('courseTitle' in data) || (data.courseTitle is string && data.courseTitle.size() <= 200))
        && (!('moduleId' in data) || isValidId(data.moduleId))
        && (!('moduleTitle' in data) || (data.moduleTitle is string && data.moduleTitle.size() <= 200))
        && data.category is string && data.category in ['Terminology', 'Protocol', 'Port Number', 'Architecture']
        && data.term is string && data.term.size() >= 1 && data.term.size() <= 140
        && data.question is string && data.question.size() >= 1 && data.question.size() <= 600
        && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 800
        && (!('portNumber' in data) || (data.portNumber is string && data.portNumber.size() <= 40))
        && (!('transportProtocol' in data) || (data.transportProtocol is string && data.transportProtocol.size() <= 40))
        && (!('osiLayer' in data) || (data.osiLayer is string && data.osiLayer.size() <= 64))
        && (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 1200))
        && (!('memoryTip' in data) || (data.memoryTip is string && data.memoryTip.size() <= 600))
        && data.masteryStatus is string && data.masteryStatus in ['unreviewed', 'mastered', 'review']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /personalFlashcards/{cardId} {
      allow get: if isValidId(cardId)
        && isVerified()
        && (resource == null || isOwner(existing().ownerUid));

      allow list: if isVerified()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(cardId)
        && isVerified()
        && isValidPersonalFlashcard(incoming())
        && incoming().id == cardId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(cardId)
        && isVerified()
        && isValidPersonalFlashcard(incoming())
        && isOwner(existing().ownerUid)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'courseId', 'courseCode', 'courseTitle', 'moduleId', 'moduleTitle',
          'category', 'term', 'question', 'answer', 'portNumber',
          'transportProtocol', 'osiLayer', 'explanation', 'memoryTip',
          'masteryStatus', 'updatedAt'
        ]);

      allow delete: if isValidId(cardId)
        && isVerified()
        && isOwner(existing().ownerUid);
    }

    function isValidQuickNote(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'courseId', 'moduleId', 'moduleTitle',
          'title', 'content', 'tags', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'courseId', 'courseCode', 'courseTitle',
          'moduleId', 'moduleTitle', 'title', 'content',
          'videoTimestampSeconds', 'tags', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isValidId(data.courseId)
        && (!('courseCode' in data) || (data.courseCode is string && data.courseCode.size() <= 64))
        && (!('courseTitle' in data) || (data.courseTitle is string && data.courseTitle.size() <= 200))
        && isValidId(data.moduleId)
        && data.moduleTitle is string && data.moduleTitle.size() >= 1 && data.moduleTitle.size() <= 200
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
        && (!('videoTimestampSeconds' in data) || (data.videoTimestampSeconds is int && data.videoTimestampSeconds >= 0 && data.videoTimestampSeconds <= 86400))
        && data.tags is list
        && data.tags.size() <= 6
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /quickNotes/{noteId} {
      allow get: if isValidId(noteId)
        && isVerified()
        && (resource == null || isOwner(existing().ownerUid));

      allow list: if isVerified()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(noteId)
        && isVerified()
        && isValidQuickNote(incoming())
        && incoming().id == noteId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(noteId)
        && isVerified()
        && isValidQuickNote(incoming())
        && isOwner(existing().ownerUid)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'courseId', 'courseCode', 'courseTitle', 'moduleId', 'moduleTitle',
          'title', 'content', 'videoTimestampSeconds', 'tags', 'updatedAt'
        ]);

      allow delete: if isValidId(noteId)
        && isVerified()
        && isOwner(existing().ownerUid);
    }

    function isValidCourseBookmark(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'courseId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'courseId', 'courseCode', 'courseTitle',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && isValidId(data.courseId)
        && (!('courseCode' in data) || (data.courseCode is string && data.courseCode.size() <= 64))
        && (!('courseTitle' in data) || (data.courseTitle is string && data.courseTitle.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /courseBookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId)
        && isVerified()
        && (resource == null || isOwner(existing().ownerUid));

      allow list: if isVerified()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isValidId(bookmarkId)
        && isVerified()
        && isValidCourseBookmark(incoming())
        && incoming().id == bookmarkId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(bookmarkId)
        && isVerified()
        && isValidCourseBookmark(incoming())
        && isOwner(existing().ownerUid)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().courseId == existing().courseId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'courseCode', 'courseTitle', 'updatedAt'
        ]);

      allow delete: if isValidId(bookmarkId)
        && isVerified()
        && isOwner(existing().ownerUid);
    }

    function isValidLabDraft(data) {
      return data.keys().hasAll([
          'uid', 'presetId', 'canvasWidth', 'canvasHeight', 'showCustomLabels',
          'gridSettings', 'devices', 'links', 'shapes', 'labels',
          'deviceCount', 'linkCount', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'presetId', 'activeSavedLabId', 'title', 'canvasWidth',
          'canvasHeight', 'showCustomLabels', 'gridSettings', 'devices',
          'links', 'shapes', 'labels', 'deviceCount', 'linkCount',
          'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidId(data.presetId)
        && (!('activeSavedLabId' in data) || isValidId(data.activeSavedLabId))
        && (!('title' in data) || (data.title is string && data.title.size() <= 120))
        && data.canvasWidth is int && data.canvasWidth >= 600 && data.canvasWidth <= 6000
        && data.canvasHeight is int && data.canvasHeight >= 400 && data.canvasHeight <= 4000
        && data.showCustomLabels is bool
        && data.gridSettings is map
        && data.gridSettings.keys().hasAll(['showGrid', 'snapToGrid', 'gridSize', 'gridStyle'])
        && data.gridSettings.keys().hasOnly(['showGrid', 'snapToGrid', 'gridSize', 'gridStyle'])
        && data.gridSettings.showGrid is bool
        && data.gridSettings.snapToGrid is bool
        && data.gridSettings.gridSize is int && data.gridSettings.gridSize >= 5 && data.gridSettings.gridSize <= 100
        && data.gridSettings.gridStyle is string && data.gridSettings.gridStyle in ['lines', 'dots']
        && data.devices is list && data.devices.size() <= 80
        && (data.devices.size() == 0 || data.devices[0] is map)
        && data.links is list && data.links.size() <= 160
        && (data.links.size() == 0 || data.links[0] is map)
        && data.shapes is list && data.shapes.size() <= 60
        && (data.shapes.size() == 0 || data.shapes[0] is map)
        && data.labels is list && data.labels.size() <= 80
        && (data.labels.size() == 0 || data.labels[0] is map)
        && data.deviceCount is int && data.deviceCount >= 0 && data.deviceCount <= 80 && data.deviceCount == data.devices.size()
        && data.linkCount is int && data.linkCount >= 0 && data.linkCount <= 160 && data.linkCount == data.links.size()
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() >= 10 && data.clientUpdatedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /labDrafts/{userId} {
      allow get: if isValidId(userId)
        && isVerified()
        && isOwner(userId);

      allow list: if isVerified()
        && resource.data.uid == request.auth.uid;

      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidLabDraft(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidLabDraft(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'presetId', 'activeSavedLabId', 'title', 'canvasWidth',
          'canvasHeight', 'showCustomLabels', 'gridSettings', 'devices',
          'links', 'shapes', 'labels', 'deviceCount', 'linkCount',
          'clientUpdatedAt', 'updatedAt'
        ]);

      allow delete: if isValidId(userId)
        && isVerified()
        && isOwner(userId);
    }

    function isValidLabExerciseTopology(data) {
      return data.keys().hasAll([
          'labId', 'canvasWidth', 'canvasHeight', 'devices', 'links',
          'shapes', 'labels', 'isPublished', 'updatedByUid', 'updatedByName',
          'updatedByRole', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'labId', 'canvasWidth', 'canvasHeight', 'devices', 'links',
          'shapes', 'labels', 'isPublished', 'updatedByUid', 'updatedByName',
          'updatedByRole', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.labId)
        && data.canvasWidth is int && data.canvasWidth >= 600 && data.canvasWidth <= 4000
        && data.canvasHeight is int && data.canvasHeight >= 400 && data.canvasHeight <= 2500
        && data.devices is list && data.devices.size() <= 80
        && (data.devices.size() == 0 || data.devices[0] is map)
        && data.links is list && data.links.size() <= 160
        && (data.links.size() == 0 || data.links[0] is map)
        && data.shapes is list && data.shapes.size() <= 60
        && (data.shapes.size() == 0 || data.shapes[0] is map)
        && data.labels is list && data.labels.size() <= 80
        && (data.labels.size() == 0 || data.labels[0] is map)
        && data.isPublished is bool
        && data.isPublished == true
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 120
        && data.updatedByRole is string && data.updatedByRole in ['admin', 'instructor']
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() >= 10 && data.clientUpdatedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /labExerciseTopologies/{labId} {
      allow get: if isValidId(labId) && isVerified();

      allow list: if isVerified() && resource.data.isPublished == true;

      allow create: if isValidId(labId)
        && isValidLabExerciseTopology(incoming())
        && isInstructorOrAdmin()
        && incoming().labId == labId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(labId)
        && isValidLabExerciseTopology(incoming())
        && isInstructorOrAdmin()
        && incoming().labId == existing().labId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'canvasWidth', 'canvasHeight', 'devices', 'links',
          'shapes', 'labels', 'isPublished', 'updatedByUid',
          'updatedByName', 'updatedByRole', 'clientUpdatedAt', 'updatedAt'
        ]);

      allow delete: if isValidId(labId)
        && isInstructorOrAdmin();
    }
  }
}
