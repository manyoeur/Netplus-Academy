{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Netplus Academy user profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "User full display name",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["student", "instructor", "admin"],
          "description": "Academy RBAC role"
        },
        "avatar": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 500
        },
        "inviteCode": {
          "type": "string",
          "description": "Optional verified invitation code used during onboarding",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt", "updatedAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Admin-issued onboarding invitation for an instructor or student registration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Invitation document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "description": "Unique invitation code",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Invited user email address",
          "minLength": 3,
          "maxLength": 254
        },
        "fullName": {
          "type": "string",
          "description": "Invited user full name",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["instructor", "student"],
          "description": "Target role granted upon registration"
        },
        "assignedCourseIds": {
          "type": "array",
          "description": "Pre-assigned or pre-enrolled course IDs"
        },
        "cohortOrSpecialty": {
          "type": "string",
          "description": "Instructor specialization or student cohort name",
          "maxLength": 120
        },
        "subscriptionTier": {
          "type": "string",
          "enum": ["free", "pro", "expert", "enterprise"],
          "description": "Allocated subscription tier"
        },
        "welcomeNote": {
          "type": "string",
          "description": "Optional onboarding note from administrator",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "revoked"],
          "description": "Invitation lifecycle status"
        },
        "invitedByUid": {
          "type": "string",
          "description": "Admin UID who issued the invitation",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invitedByName": {
          "type": "string",
          "description": "Admin display name",
          "minLength": 1,
          "maxLength": 120
        },
        "invitedByEmail": {
          "type": "string",
          "format": "email",
          "description": "Admin email address",
          "minLength": 3,
          "maxLength": 254
        },
        "acceptedByUid": {
          "type": "string",
          "description": "UID of the user who accepted the invitation",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when accepted",
          "maxLength": 64
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO expiration timestamp",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "code",
        "email",
        "fullName",
        "role",
        "assignedCourseIds",
        "cohortOrSpecialty",
        "status",
        "invitedByUid",
        "invitedByName",
        "invitedByEmail",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "CoursePayment": {
      "title": "CoursePayment",
      "description": "Completed payment and invoice record for a student enrolling in a course.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payment record document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "transactionId": {
          "type": "string",
          "description": "Payment transaction identifier",
          "minLength": 4,
          "maxLength": 64
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Invoice receipt number",
          "minLength": 4,
          "maxLength": 64
        },
        "studentUid": {
          "type": "string",
          "description": "Firebase Auth UID of the paying student",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Paying student display name",
          "minLength": 1,
          "maxLength": 120
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "description": "Paying student email address",
          "minLength": 3,
          "maxLength": 254
        },
        "courseId": {
          "type": "string",
          "description": "Enrolled course ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseCode": {
          "type": "string",
          "description": "Enrolled course code",
          "minLength": 1,
          "maxLength": 64
        },
        "courseTitle": {
          "type": "string",
          "description": "Enrolled course title",
          "minLength": 1,
          "maxLength": 200
        },
        "originalPrice": {
          "type": "number",
          "description": "Base course tuition in USD"
        },
        "discountAmount": {
          "type": "number",
          "description": "Discount applied in USD"
        },
        "amountPaid": {
          "type": "number",
          "description": "Final amount charged in USD"
        },
        "currency": {
          "type": "string",
          "enum": ["USD"],
          "description": "Payment currency code"
        },
        "promoCode": {
          "type": "string",
          "description": "Optional promo voucher code applied",
          "maxLength": 40
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["card", "paypal", "bank_transfer"],
          "description": "Selected checkout payment method"
        },
        "cardLast4": {
          "type": "string",
          "description": "Last 4 digits when paid by card",
          "maxLength": 8
        },
        "status": {
          "type": "string",
          "enum": ["paid", "refunded"],
          "description": "Payment settlement status"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of settlement",
          "maxLength": 64
        },
        "accessStartDate": {
          "type": "string",
          "description": "Enrollment access start date (YYYY-MM-DD)",
          "maxLength": 32
        },
        "accessExpiresAt": {
          "type": "string",
          "description": "Enrollment access expiration date (YYYY-MM-DD)",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "transactionId",
        "invoiceNumber",
        "studentUid",
        "studentName",
        "studentEmail",
        "courseId",
        "courseCode",
        "courseTitle",
        "originalPrice",
        "discountAmount",
        "amountPaid",
        "currency",
        "paymentMethod",
        "status",
        "paidAt",
        "accessStartDate",
        "accessExpiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "LabTopology": {
      "title": "LabTopology",
      "description": "Saved student network topology layout, device configurations, cabling, and objective progress from the Network Lab Simulator.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Saved lab topology document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the student who owns this saved lab",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Student-defined title for the saved lab layout",
          "minLength": 1,
          "maxLength": 120
        },
        "presetId": {
          "type": "string",
          "description": "Base lab preset identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "devices": {
          "type": "array",
          "description": "Configured simulated routers, switches, PCs, and servers"
        },
        "links": {
          "type": "array",
          "description": "Configured Ethernet, Fiber, and Serial cable connections"
        },
        "deviceCount": {
          "type": "number",
          "description": "Number of devices in the saved topology (0-40)"
        },
        "linkCount": {
          "type": "number",
          "description": "Number of cable links in the saved topology (0-80)"
        },
        "objectivesPassed": {
          "type": "number",
          "description": "Number of completed lab objectives"
        },
        "objectivesTotal": {
          "type": "number",
          "description": "Total number of lab objectives in the preset"
        },
        "status": {
          "type": "string",
          "enum": ["in_progress", "completed"],
          "description": "Project completion status (in_progress or completed)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "title",
        "presetId",
        "devices",
        "links",
        "deviceCount",
        "linkCount",
        "objectivesPassed",
        "objectivesTotal",
        "createdAt",
        "updatedAt"
      ]
    },
    "LearningStreak": {
      "title": "LearningStreak",
      "description": "Owner-isolated daily learning streak history and consecutive study day records.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "activeDates": {
          "type": "array",
          "description": "Sorted unique YYYY-MM-DD local study dates (capped at 365 days)"
        },
        "currentStreak": {
          "type": "number",
          "description": "Current consecutive learning days count"
        },
        "longestStreak": {
          "type": "number",
          "description": "Longest consecutive learning days count achieved"
        },
        "lastActiveDate": {
          "type": "string",
          "description": "Most recent YYYY-MM-DD study date",
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "uid",
        "activeDates",
        "currentStreak",
        "longestStreak",
        "lastActiveDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudyGoal": {
      "title": "StudyGoal",
      "description": "Owner-isolated daily study goal target in minutes and daily course/lab/practice study progress.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dailyGoalMinutes": {
          "type": "number",
          "description": "Target study duration in minutes per day (5-300)"
        },
        "dateKey": {
          "type": "string",
          "description": "Local calendar date YYYY-MM-DD",
          "minLength": 10,
          "maxLength": 10
        },
        "courseSeconds": {
          "type": "number",
          "description": "Seconds spent interacting with course content today"
        },
        "labSeconds": {
          "type": "number",
          "description": "Seconds spent interacting with lab simulator today"
        },
        "practiceSeconds": {
          "type": "number",
          "description": "Seconds spent practicing with flashcards or tools today"
        },
        "creditedModuleIds": {
          "type": "array",
          "description": "Module IDs already credited toward today's study goal"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "uid",
        "dailyGoalMinutes",
        "dateKey",
        "courseSeconds",
        "labSeconds",
        "practiceSeconds",
        "creditedModuleIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "PersonalFlashcard": {
      "title": "PersonalFlashcard",
      "description": "Student-created personal flashcard tagged to a specific Netplus Academy course and optional module.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Flashcard document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the student who owns this flashcard",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "description": "Course ID this flashcard belongs to (or 'general' for cross-course cards)",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseCode": {
          "type": "string",
          "description": "Display code of the tagged course",
          "maxLength": 64
        },
        "courseTitle": {
          "type": "string",
          "description": "Display title of the tagged course",
          "maxLength": 200
        },
        "moduleId": {
          "type": "string",
          "description": "Optional module ID within the tagged course",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "moduleTitle": {
          "type": "string",
          "description": "Optional module title for display",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": ["Terminology", "Protocol", "Port Number", "Architecture"],
          "description": "Networking flashcard category"
        },
        "term": {
          "type": "string",
          "description": "Primary networking term or concept",
          "minLength": 1,
          "maxLength": 140
        },
        "question": {
          "type": "string",
          "description": "Front-of-card recall prompt",
          "minLength": 1,
          "maxLength": 600
        },
        "answer": {
          "type": "string",
          "description": "Back-of-card concise answer",
          "minLength": 1,
          "maxLength": 800
        },
        "portNumber": {
          "type": "string",
          "description": "Optional TCP/UDP port number",
          "maxLength": 40
        },
        "transportProtocol": {
          "type": "string",
          "description": "Optional transport protocol tag",
          "maxLength": 40
        },
        "osiLayer": {
          "type": "string",
          "description": "Optional OSI model layer",
          "maxLength": 64
        },
        "explanation": {
          "type": "string",
          "description": "Optional technical explanation",
          "maxLength": 1200
        },
        "memoryTip": {
          "type": "string",
          "description": "Optional mnemonic or study tip",
          "maxLength": 600
        },
        "masteryStatus": {
          "type": "string",
          "enum": ["unreviewed", "mastered", "review"],
          "description": "Student self-graded mastery state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "courseId",
        "category",
        "term",
        "question",
        "answer",
        "masteryStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuickNote": {
      "title": "QuickNote",
      "description": "Student technical concept quick note captured while watching course videos or studying modules",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique quick note identifier",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase UID of the student who owns the quick note",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "courseId": {
          "type": "string",
          "description": "Associated course identifier",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "courseCode": {
          "type": "string",
          "description": "Optional course code tag",
          "maxLength": 64
        },
        "courseTitle": {
          "type": "string",
          "description": "Optional course title snapshot",
          "maxLength": 200
        },
        "moduleId": {
          "type": "string",
          "description": "Associated course module identifier",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "moduleTitle": {
          "type": "string",
          "description": "Module title snapshot",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "description": "Technical concept title",
          "minLength": 1,
          "maxLength": 140
        },
        "content": {
          "type": "string",
          "description": "Technical concept note body",
          "minLength": 1,
          "maxLength": 4000
        },
        "videoTimestampSeconds": {
          "type": "integer",
          "description": "Optional captured video lecture timestamp in seconds"
        },
        "tags": {
          "type": "array",
          "description": "Optional technical concept tags (max 6)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "courseId",
        "moduleId",
        "moduleTitle",
        "title",
        "content",
        "tags",
        "createdAt",
        "updatedAt"
      ]
    },
    "CourseBookmark": {
      "title": "CourseBookmark",
      "description": "Student-saved favorite course bookmark synced to the student dashboard",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic bookmark identifier (bm_{ownerUid}_{courseId})",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase UID of the student who saved the bookmark",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "courseId": {
          "type": "string",
          "description": "Bookmarked course identifier",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "courseCode": {
          "type": "string",
          "description": "Optional course code snapshot",
          "maxLength": 64
        },
        "courseTitle": {
          "type": "string",
          "description": "Optional course title snapshot",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "courseId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile documents for Netplus Academy authentication."
    },
    "/invitations/{inviteId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Admin-managed instructor and student registration invitations."
    },
    "/coursePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/CoursePayment" },
      "description": "Student course enrollment payment receipts and transaction records."
    },
    "/labTopologies/{topologyId}": {
      "schema": { "$ref": "#/entities/LabTopology" },
      "description": "Owner-isolated saved network topology layouts and lab progress snapshots."
    },
    "/learningStreaks/{userId}": {
      "schema": { "$ref": "#/entities/LearningStreak" },
      "description": "Owner-isolated daily learning streak records per student."
    },
    "/studyGoals/{userId}": {
      "schema": { "$ref": "#/entities/StudyGoal" },
      "description": "Owner-isolated daily study goal target and progress per student."
    },
    "/personalFlashcards/{cardId}": {
      "schema": { "$ref": "#/entities/PersonalFlashcard" },
      "description": "Owner-isolated personal manual flashcards created by students and tagged by course."
    },
    "/quickNotes/{noteId}": {
      "schema": { "$ref": "#/entities/QuickNote" },
      "description": "Owner-isolated student quick notes captured while watching course videos."
    },
    "/courseBookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/CourseBookmark" },
      "description": "Owner-isolated student course bookmarks for quick dashboard Favorites access."
    }
  }
}
