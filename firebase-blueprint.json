{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Netplus Academy user profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "User full display name",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["student", "instructor", "admin"],
          "description": "Academy RBAC role"
        },
        "avatar": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 500
        },
        "inviteCode": {
          "type": "string",
          "description": "Optional verified invitation code used during onboarding",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt", "updatedAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Admin-issued onboarding invitation for an instructor or student registration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Invitation document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "description": "Unique invitation code",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Invited user email address",
          "minLength": 3,
          "maxLength": 254
        },
        "fullName": {
          "type": "string",
          "description": "Invited user full name",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["instructor", "student"],
          "description": "Target role granted upon registration"
        },
        "assignedCourseIds": {
          "type": "array",
          "description": "Pre-assigned or pre-enrolled course IDs"
        },
        "cohortOrSpecialty": {
          "type": "string",
          "description": "Instructor specialization or student cohort name",
          "maxLength": 120
        },
        "subscriptionTier": {
          "type": "string",
          "enum": ["free", "pro", "expert", "enterprise"],
          "description": "Allocated subscription tier"
        },
        "welcomeNote": {
          "type": "string",
          "description": "Optional onboarding note from administrator",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "revoked"],
          "description": "Invitation lifecycle status"
        },
        "invitedByUid": {
          "type": "string",
          "description": "Admin UID who issued the invitation",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "invitedByName": {
          "type": "string",
          "description": "Admin display name",
          "minLength": 1,
          "maxLength": 120
        },
        "invitedByEmail": {
          "type": "string",
          "format": "email",
          "description": "Admin email address",
          "minLength": 3,
          "maxLength": 254
        },
        "acceptedByUid": {
          "type": "string",
          "description": "UID of the user who accepted the invitation",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when accepted",
          "maxLength": 64
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO expiration timestamp",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "code",
        "email",
        "fullName",
        "role",
        "assignedCourseIds",
        "cohortOrSpecialty",
        "status",
        "invitedByUid",
        "invitedByName",
        "invitedByEmail",
        "expiresAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "CoursePayment": {
      "title": "CoursePayment",
      "description": "Completed payment and invoice record for a student enrolling in a course.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payment record document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "transactionId": {
          "type": "string",
          "description": "Payment transaction identifier",
          "minLength": 4,
          "maxLength": 64
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Invoice receipt number",
          "minLength": 4,
          "maxLength": 64
        },
        "studentUid": {
          "type": "string",
          "description": "Firebase Auth UID of the paying student",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Paying student display name",
          "minLength": 1,
          "maxLength": 120
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "description": "Paying student email address",
          "minLength": 3,
          "maxLength": 254
        },
        "courseId": {
          "type": "string",
          "description": "Enrolled course ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseCode": {
          "type": "string",
          "description": "Enrolled course code",
          "minLength": 1,
          "maxLength": 64
        },
        "courseTitle": {
          "type": "string",
          "description": "Enrolled course title",
          "minLength": 1,
          "maxLength": 200
        },
        "originalPrice": {
          "type": "number",
          "description": "Base course tuition in USD"
        },
        "discountAmount": {
          "type": "number",
          "description": "Discount applied in USD"
        },
        "amountPaid": {
          "type": "number",
          "description": "Final amount charged in USD"
        },
        "currency": {
          "type": "string",
          "enum": ["USD"],
          "description": "Payment currency code"
        },
        "promoCode": {
          "type": "string",
          "description": "Optional promo voucher code applied",
          "maxLength": 40
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["card", "paypal", "bank_transfer"],
          "description": "Selected checkout payment method"
        },
        "cardLast4": {
          "type": "string",
          "description": "Last 4 digits when paid by card",
          "maxLength": 8
        },
        "status": {
          "type": "string",
          "enum": ["paid", "refunded"],
          "description": "Payment settlement status"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of settlement",
          "maxLength": 64
        },
        "accessStartDate": {
          "type": "string",
          "description": "Enrollment access start date (YYYY-MM-DD)",
          "maxLength": 32
        },
        "accessExpiresAt": {
          "type": "string",
          "description": "Enrollment access expiration date (YYYY-MM-DD)",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "transactionId",
        "invoiceNumber",
        "studentUid",
        "studentName",
        "studentEmail",
        "courseId",
        "courseCode",
        "courseTitle",
        "originalPrice",
        "discountAmount",
        "amountPaid",
        "currency",
        "paymentMethod",
        "status",
        "paidAt",
        "accessStartDate",
        "accessExpiresAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile documents for Netplus Academy authentication."
    },
    "/invitations/{inviteId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Admin-managed instructor and student registration invitations."
    },
    "/coursePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/CoursePayment" },
      "description": "Student course enrollment payment receipts and transaction records."
    }
  }
}
