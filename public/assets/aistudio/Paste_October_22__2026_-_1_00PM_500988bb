    function switchStudioStep(step) {
      studioCurrentStep = step;

      const s1 = document.getElementById('studio-step-1');
      const s2 = document.getElementById('studio-step-2');
      const s3 = document.getElementById('studio-step-3');

      const btnNext = document.getElementById('studio-next-btn');
      const btnPrev = document.getElementById('studio-prev-btn');
      const btnPublish = document.getElementById('studio-publish-btn');

      if (s1) s1.classList.add('hidden');
      if (s2) s2.classList.add('hidden');
      if (s3) s3.classList.add('hidden');

      if (step === 1) {
        if (s1) s1.classList.remove('hidden');
        if (btnPrev) btnPrev.classList.add('hidden');
        if (btnNext) btnNext.classList.remove('hidden');
        if (btnPublish) btnPublish.classList.add('hidden');
      } else if (step === 2) {
        if (s2) s2.classList.remove('hidden');
        if (btnPrev) btnPrev.classList.remove('hidden');
        if (btnNext) btnNext.classList.remove('hidden');
        if (btnPublish) btnPublish.classList.add('hidden');
      } else if (step === 3) {
        if (s3) s3.classList.remove('hidden');
        if (btnPrev) btnPrev.classList.remove('hidden');
        if (btnNext) btnNext.classList.add('hidden');
        if (btnPublish) btnPublish.classList.remove('hidden');
      }

      for (let i = 1; i <= 3; i++) {
        const btn = document.getElementById(`studio-step-btn-${i}`);
        if (btn) {
          if (i === step) {
            btn.className = "flex items-center gap-2 text-brand-600 dark:text-brand-400 font-bold";
          } else if (i < step) {
            btn.className = "flex items-center gap-2 text-emerald-500 font-bold";
          } else {
            btn.className = "flex items-center gap-2 text-gray-400";
          }
        }
      }
    }

    function nextStudioStep() {
      if (studioCurrentStep < 3) switchStudioStep(studioCurrentStep + 1);
    }

    function prevStudioStep() {
      if (studioCurrentStep > 1) switchStudioStep(studioCurrentStep - 1);
    }

