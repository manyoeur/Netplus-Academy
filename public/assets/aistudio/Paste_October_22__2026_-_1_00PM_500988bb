    function openQuizModal() {
      if (!currentUser) {
        openAuthModal('login');
        return;
      }
      
      activeQuizQuestions = currentActiveCourse.quizzes && currentActiveCourse.quizzes.length > 0 ? currentActiveCourse.quizzes : [
