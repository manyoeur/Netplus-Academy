              </div>
              <span class="text-[10px] text-gray-400 font-mono">${lesson.duration}</span>
            </div>
          `;
        });

        modBox.innerHTML = `
          <div class="p-3 bg-gray-50 dark:bg-gray-700/40 text-xs font-bold text-gray-800 dark:text-gray-200 flex justify-between items-center border-b border-gray-200 dark:border-gray-700">
            <span>${mod.title}</span>
          </div>
          <div class="p-2 space-y-1">
            ${lessonsHTML}
          </div>
        `;
        list.appendChild(modBox);
      });

      if (window.lucide) {
        lucide.createIcons();
      }
    }

