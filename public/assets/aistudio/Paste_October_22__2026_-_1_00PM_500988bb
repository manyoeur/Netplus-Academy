              <span class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                <i data-lucide="clock" class="w-3.5 h-3.5"></i> ${course.duration}
              </span>
              <div class="flex items-center gap-2">
                ${isInstructor ? `<button onclick="openCourseStudioModal('${course.id}', true)" class="px-2.5 py-1.5 rounded-xl bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-xs font-bold text-gray-700 dark:text-gray-200 transition" title="Manage Course Content"><i data-lucide="settings" class="w-3.5 h-3.5"></i></button>` : ''}
                <button onclick="startCourse('${course.id}')" class="px-3.5 py-1.5 rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-900/30 dark:text-brand-300 text-xs font-bold hover:bg-brand-600 hover:text-white dark:hover:bg-brand-600 transition">
