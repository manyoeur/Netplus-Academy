    // PUBLISH OR UPDATE COURSE ACTION
    function publishNewCourse() {
      const titleIn = document.getElementById('new-course-title');
      const title = titleIn ? titleIn.value.trim() : '';
      if (!title) {
        showToast('Please enter a course title');
        switchStudioStep(1);
        return;
      }

      const category = document.getElementById('new-course-category')?.value || 'Web Dev';
      const level = document.getElementById('new-course-level')?.value || 'Beginner';
      const duration = document.getElementById('new-course-duration')?.value || '10.0 Hours';
      const instructor = document.getElementById('new-course-instructor')?.value || (currentUser ? currentUser.name : 'Sarah Chen');
      const thumbnail = document.getElementById('new-course-thumbnail')?.value || 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&q=80&w=600';

      if (isStudioEditMode && editingCourseId) {
        const existingIdx = coursesData.findIndex(c => c.id === editingCourseId);
        if (existingIdx !== -1) {
          coursesData[existingIdx] = {
            ...coursesData[existingIdx],
            title: title,
            category: category,
            level: level,
            duration: duration,
            instructor: instructor,
            thumbnail: thumbnail,
            modules: studioModulesList,
            quizzes: studioQuizzesList
          };

          if (currentActiveCourse && currentActiveCourse.id === editingCourseId) {
            currentActiveCourse = coursesData[existingIdx];
            if (currentActiveCourse.modules && currentActiveCourse.modules.length > 0 && currentActiveCourse.modules[0].lessons.length > 0) {
              activeLessonObj = currentActiveCourse.modules[0].lessons[0];
            }
            loadActiveLessonContent();
            renderModulesSidebar();
          }

          localStorage.setItem('apex_academy_courses', JSON.stringify(coursesData));
          closeCourseStudioModal();
          renderCourseGrid();
          renderEnrolledCourses();
          showToast(`✅ Course "${title}" updated successfully!`);
          return;
        }
      }

      const newCourseObj = {
        id: `c_${Date.now()}`,
        title: title,
        category: category,
        level: level,
        duration: duration,
        rating: '5.0',
        students: '1',
        thumbnail: thumbnail,
        progress: 0,
        instructor: instructor,
        modules: studioModulesList.length > 0 ? studioModulesList : [],
        quizzes: studioQuizzesList.length > 0 ? studioQuizzesList : []
      };

      coursesData.unshift(newCourseObj);
      localStorage.setItem('apex_academy_courses', JSON.stringify(coursesData));

      closeCourseStudioModal();
      renderCourseGrid();
      switchView('catalog');
      showToast(`🎉 Course "${title}" published successfully!`);
    }

