        card.innerHTML = `
          <div class="relative overflow-hidden aspect-video">
            <img src="${course.thumbnail}" alt="${course.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-gray-900/80 backdrop-blur-md text-white">${course.category}</span>
            <div class="absolute top-3 right-3 flex items-center gap-1.5">
              ${instructorEditBtn}
              <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-brand-600 text-white">${course.level}</span>
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
