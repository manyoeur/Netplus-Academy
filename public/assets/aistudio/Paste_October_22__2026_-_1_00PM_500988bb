<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apex Academy | Next-Gen Learning & Course Studio</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Chart.js for analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            },
            accent: {
              500: '#8b5cf6',
              600: '#7c3aed',
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['Fira Code', 'monospace']
          }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(156, 163, 175, 0.4); border-radius: 9999px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(156, 163, 175, 0.6); }
    .toast-animate { animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    @keyframes slideIn {
      from { transform: translateY(-100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-100 transition-colors duration-200 min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

  <!-- TOP NAVIGATION HEADER -->
  <header class="sticky top-0 z-40 bg-white/90 dark:bg-gray-800/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 gap-4">
        
        <!-- Left: Logo & Nav Links -->
        <div class="flex items-center gap-6">
          <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
          
          <a href="#" onclick="switchView('catalog')" class="flex items-center gap-2 font-bold text-xl tracking-tight text-gray-900 dark:text-white">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-accent-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
              <i data-lucide="graduation-cap" class="w-5 h-5"></i>
            </div>
            <span>Apex<span class="text-brand-500">Academy</span></span>
          </a>

          <!-- Desktop Nav Navigation -->
          <nav class="hidden lg:flex items-center gap-1">
            <button onclick="switchView('catalog')" id="nav-catalog" class="nav-link px-3 py-2 rounded-lg text-sm font-medium transition-colors text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-900/30">
              <i data-lucide="compass" class="w-4 h-4 inline mr-1.5"></i>Catalog
            </button>
            <button onclick="switchView('dashboard')" id="nav-dashboard" class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-gray-100 dark:hover:bg-gray-700/50">
              <i data-lucide="layout-dashboard" class="w-4 h-4 inline mr-1.5"></i>Dashboard
            </button>
            <button onclick="switchView('viewer')" id="nav-viewer" class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-gray-100 dark:hover:bg-gray-700/50">
              <i data-lucide="book-open" class="w-4 h-4 inline mr-1.5"></i>Active Lesson
            </button>
            <button onclick="switchView('sandbox')" id="nav-sandbox" class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-gray-100 dark:hover:bg-gray-700/50">
              <i data-lucide="code" class="w-4 h-4 inline mr-1.5"></i>Sandbox
            </button>
          </nav>
        </div>

        <!-- Center: Search Bar -->
        <div class="hidden md:flex flex-1 max-w-md mx-4 relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
            <i data-lucide="search" class="w-4 h-4"></i>
          </div>
          <input type="text" id="global-search" onkeyup="handleGlobalSearch(this.value)" placeholder="Search courses, lessons, topics..." class="w-full pl-9 pr-4 py-2 bg-gray-100 dark:bg-gray-700/50 border border-transparent focus:border-brand-500 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 transition-all text-gray-800 dark:text-gray-100 placeholder-gray-400">
        </div>

        <!-- Right: Actions & Auth / Profile Area -->
        <div class="flex items-center gap-3">
          
          <!-- Instructor Action Buttons (Shown when Instructor is active) -->
          <div id="header-instructor-actions" class="hidden sm:flex items-center gap-2">
            <button onclick="openCourseStudioModal(null, true)" class="px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 font-bold text-xs hover:bg-gray-200 dark:hover:bg-gray-600 transition flex items-center gap-1.5 border border-gray-200 dark:border-gray-600" title="Manage Existing Courses">
              <i data-lucide="file-edit" class="w-4 h-4 text-brand-500"></i>
              <span>Manage Courses</span>
            </button>
            <button id="header-create-course-btn" onclick="openCourseStudioModal()" class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-accent-600 to-brand-600 text-white font-bold text-xs shadow-md hover:opacity-90 transition">
              <i data-lucide="plus-circle" class="w-4 h-4"></i>
              <span>Create Course</span>
            </button>
          </div>

          <!-- Persona Switcher Quick Dropdown -->
          <div class="hidden xl:flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-gray-100 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 text-xs">
            <i data-lucide="user-check" class="w-3.5 h-3.5 text-brand-500"></i>
            <span class="text-gray-400 text-[10px] font-medium">Demo Persona:</span>
            <select id="persona-selector" onchange="switchPersona(this.value)" class="bg-transparent text-gray-800 dark:text-gray-200 font-semibold focus:outline-none cursor-pointer">
              <option value="student1">Alex Rivera (Student)</option>
              <option value="instructor1">Sarah Chen (Instructor)</option>
              <option value="guest">Guest User (Logged Out)</option>
            </select>
          </div>

          <!-- Streak Indicator -->
          <div id="streak-badge" class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-semibold border border-amber-500/20" title="Current Daily Streak">
            <i data-lucide="flame" class="w-4 h-4 text-amber-500 fill-amber-500"></i>
            <span id="header-streak-text">5 Day Streak</span>
          </div>

          <!-- Theme Toggle -->
          <button id="theme-toggle" class="p-2 rounded-xl text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" title="Toggle Theme">
            <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
            <i data-lucide="moon" class="w-5 h-5 block dark:hidden"></i>
          </button>

          <!-- AUTH STATE: LOGGED IN PROFILE vs LOGGED OUT BUTTONS -->
          <div id="auth-state-container" class="flex items-center gap-2 pl-2 border-l border-gray-200 dark:border-gray-700">
            <!-- Dynamically populated via updateAuthUI() -->
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- USER PROFILE DROPDOWN MENU -->
  <div id="profile-dropdown" class="hidden absolute right-6 top-16 z-50 w-64 bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700 p-2 space-y-1">
    <div class="px-3 py-2.5 border-b border-gray-100 dark:border-gray-700/60">
      <p id="dropdown-user-name" class="text-sm font-bold text-gray-900 dark:text-white">Alex Rivera</p>
      <p id="dropdown-user-email" class="text-xs text-gray-500 truncate">alex.rivera@academy.io</p>
      <div class="mt-2 flex items-center justify-between text-[10px] font-semibold text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-900/40 px-2 py-1 rounded-md">
        <span id="dropdown-user-role">Pro Student</span>
        <span id="dropdown-user-xp">1,450 XP</span>
      </div>
    </div>
    <button onclick="openCourseStudioModal(); closeDropdowns()" id="dropdown-create-course-option" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs text-brand-600 dark:text-brand-400 font-semibold hover:bg-brand-50 dark:hover:bg-brand-900/30 rounded-xl transition">
      <i data-lucide="plus-circle" class="w-4 h-4"></i> Course Creator Studio
    </button>
    <button onclick="switchView('dashboard'); closeDropdowns()" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-xl transition">
      <i data-lucide="layout-dashboard" class="w-4 h-4 text-brand-500"></i> My Dashboard
    </button>
    <button onclick="switchView('sandbox'); closeDropdowns()" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-xl transition">
      <i data-lucide="notebook-pen" class="w-4 h-4 text-accent-500"></i> Saved Notes
    </button>
    <button onclick="showCertificateModal(); closeDropdowns()" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-xl transition">
      <i data-lucide="award" class="w-4 h-4 text-amber-500"></i> Certificates
    </button>
    <div class="border-t border-gray-100 dark:border-gray-700 my-1"></div>
    <button onclick="performLogout()" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl transition font-medium">
      <i data-lucide="log-out" class="w-4 h-4"></i> Log Out
    </button>
  </div>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div id="mobile-menu" class="hidden fixed inset-0 z-50 bg-gray-900/60 backdrop-blur-sm lg:hidden">
    <div class="w-72 bg-white dark:bg-gray-800 h-full p-5 flex flex-col justify-between shadow-xl">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-gray-200 dark:border-gray-700">
          <div class="flex items-center gap-2 font-bold text-lg">
            <i data-lucide="graduation-cap" class="w-6 h-6 text-brand-500"></i>
            <span>Apex Academy</span>
          </div>
          <button id="close-mobile-menu" class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
        </div>
        
        <!-- Mobile Persona Selector -->
        <div class="mt-4 p-2.5 rounded-xl bg-gray-100 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600">
          <label class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Switch User Persona</label>
          <select id="mobile-persona-selector" onchange="switchPersona(this.value); closeMobileMenu()" class="w-full bg-transparent text-xs font-semibold text-gray-800 dark:text-gray-200 focus:outline-none">
            <option value="student1">Alex Rivera (Student)</option>
            <option value="instructor1">Sarah Chen (Instructor)</option>
            <option value="guest">Guest User (Logged Out)</option>
          </select>
        </div>

        <button onclick="openCourseStudioModal(); closeMobileMenu()" class="mt-3 w-full py-2.5 rounded-xl bg-gradient-to-r from-accent-600 to-brand-600 text-white font-bold text-xs shadow-md flex items-center justify-center gap-2">
          <i data-lucide="plus-circle" class="w-4 h-4"></i> Create New Course
        </button>

        <nav class="mt-4 flex flex-col gap-2">
          <button onclick="switchView('catalog'); closeMobileMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-700">
            <i data-lucide="compass" class="w-5 h-5"></i> Course Catalog
          </button>
          <button onclick="switchView('dashboard'); closeMobileMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-700">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i> My Dashboard
          </button>
          <button onclick="switchView('viewer'); closeMobileMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-700">
            <i data-lucide="book-open" class="w-5 h-5"></i> Active Lesson
          </button>
          <button onclick="switchView('sandbox'); closeMobileMenu()" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-700">
            <i data-lucide="code" class="w-5 h-5"></i> Interactive Sandbox
          </button>
        </nav>
      </div>
      <div id="mobile-menu-footer" class="pt-4 border-t border-gray-200 dark:border-gray-700 text-xs text-gray-500">
        <!-- Dynamic via JS -->
      </div>
    </div>
  </div>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- VIEW 1: COURSE CATALOG & EXPLORER -->
    <section id="view-catalog" class="space-y-6">
      
      <!-- Hero Banner -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-brand-900 via-brand-800 to-accent-600 p-8 sm:p-10 text-white shadow-xl">
        <div class="relative z-10 max-w-2xl space-y-4">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/20 backdrop-blur-md text-brand-100 border border-white/10">Master Modern Tech Skills</span>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Learn or Teach Skills with Interactive Courses</h1>
          <p class="text-brand-100 text-sm sm:text-base leading-relaxed">Interactive video lessons, built-in coding sandboxes, real-world projects, and instant skill assessments designed by world-class instructors.</p>
          <div class="flex flex-wrap gap-3 pt-2">
            <button onclick="filterCategory('All')" class="px-5 py-2.5 rounded-xl bg-white text-brand-900 font-semibold text-sm hover:bg-brand-50 transition shadow-md">Explore Catalog (<span id="total-course-count-badge">5</span>)</button>
            <button onclick="openCourseStudioModal()" class="px-5 py-2.5 rounded-xl bg-accent-600 hover:bg-accent-700 text-white border border-white/20 font-bold text-sm transition backdrop-blur-md flex items-center gap-2 shadow-lg">
              <i data-lucide="plus-circle" class="w-4 h-4"></i> Teach & Publish Course
            </button>
          </div>
        </div>
        <i data-lucide="sparkles" class="absolute right-6 -bottom-10 w-72 h-72 text-white/5 pointer-events-none"></i>
      </div>

      <!-- Filters & Controls Bar -->
      <div class="bg-white dark:bg-gray-800 p-4 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm flex flex-col md:flex-row gap-4 items-center justify-between">
        <!-- Category Badges -->
        <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 custom-scrollbar" id="category-filters">
          <button onclick="filterCategory('All')" class="cat-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition bg-brand-600 text-white shadow-sm" data-cat="All">All Categories</button>
          <button onclick="filterCategory('Web Dev')" class="cat-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-cat="Web Dev">Web Dev</button>
          <button onclick="filterCategory('Cybersecurity')" class="cat-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-cat="Cybersecurity">Cybersecurity</button>
          <button onclick="filterCategory('Cloud')" class="cat-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-cat="Cloud">Cloud</button>
          <button onclick="filterCategory('Linux')" class="cat-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-cat="Linux">Linux</button>
          <button onclick="filterCategory('Data Science')" class="cat-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-cat="Data Science">Data Science</button>
          <button onclick="filterCategory('AI & ML')" class="cat-btn px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600" data-cat="AI & ML">AI & ML</button>
        </div>

        <!-- Level Filter Dropdown & Studio Quick Launcher -->
        <div class="flex items-center gap-3 w-full md:w-auto justify-end">
          <label class="text-xs font-medium text-gray-500 dark:text-gray-400 flex items-center gap-1">
            <i data-lucide="sliders-horizontal" class="w-3.5 h-3.5"></i> Level:
          </label>
          <select id="level-filter" onchange="applyFilters()" class="bg-gray-100 dark:bg-gray-700 border-none text-xs font-medium rounded-xl px-3 py-2 text-gray-700 dark:text-gray-200 focus:ring-2 focus:ring-brand-500">
            <option value="All">All Levels</option>
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Advanced">Advanced</option>
          </select>
        </div>
      </div>

      <!-- Course Cards Grid -->
      <div id="course-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- JS renders courses here dynamically -->
      </div>
    </section>

    <!-- VIEW 2: INTERACTIVE LESSON VIEWER -->
    <section id="view-viewer" class="hidden space-y-4">
      
      <!-- Top Title & Navigation Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white dark:bg-gray-800 p-4 rounded-2xl border border-gray-200 dark:border-gray-700">
        <div>
          <div class="flex items-center gap-2 text-xs font-semibold text-brand-600 dark:text-brand-400">
            <span id="active-course-category">Web Dev</span> &bull; <span id="active-course-title">Full-Stack React & Node Mastery</span>
          </div>
          <h2 id="active-lesson-title" class="text-xl font-bold text-gray-900 dark:text-white mt-0.5">Lesson 1.2: Understanding React State & Hooks</h2>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="toggleLessonCompletion()" id="btn-complete-lesson" class="px-4 py-2 rounded-xl text-xs font-semibold border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 transition flex items-center gap-1.5">
            <i data-lucide="check-circle-2" class="w-4 h-4"></i>
            <span id="complete-btn-text">Mark as Complete</span>
          </button>
          <button onclick="switchView('sandbox')" class="px-4 py-2 rounded-xl text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white transition flex items-center gap-1.5">
            <i data-lucide="code" class="w-4 h-4"></i>
            <span>Practice Sandbox</span>
          </button>
        </div>
      </div>

      <!-- Main Lesson Interface Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left / Center Column: Video Player, Lesson Content & Q&A -->
        <div class="lg:col-span-8 space-y-6">
          
          <!-- Custom Interactive Video Player Container -->
          <div class="relative bg-black rounded-2xl overflow-hidden shadow-xl aspect-video border border-gray-800 group" id="video-player-container">
            <iframe id="video-iframe" class="w-full h-full border-0 hidden" src="" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>

            <div id="video-thumbnail-wrapper" class="relative w-full h-full">
              <img id="video-thumbnail" src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=1200" alt="Video cover" class="w-full h-full object-cover opacity-60">
              
              <!-- GUEST / LOGGED-OUT LOCK OVERLAY -->
              <div id="video-auth-lock" class="hidden absolute inset-0 bg-gray-900/85 backdrop-blur-md z-20 flex flex-col items-center justify-center p-6 text-center space-y-4">
                <div class="w-16 h-16 rounded-2xl bg-brand-500/20 text-brand-400 border border-brand-500/30 flex items-center justify-center shadow-inner">
                  <i data-lucide="lock" class="w-8 h-8"></i>
                </div>
                <div class="max-w-md space-y-1">
                  <h3 class="text-xl font-bold text-white">Full Video Lesson Locked</h3>
                  <p class="text-xs text-gray-300">Sign in or register your free Apex Academy account to access interactive video streaming, code sandboxes, and earned certificates.</p>
                </div>
                <div class="flex items-center gap-3 pt-2">
                  <button onclick="openAuthModal('login')" class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-lg transition">Sign In to Unlock</button>
                  <button onclick="openAuthModal('register')" class="px-5 py-2.5 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-200 border border-gray-700 font-bold text-xs transition">Create Account</button>
                </div>
              </div>

              <!-- Center Play Overlay Button -->
              <button id="video-play-overlay" onclick="togglePlayVideo()" class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/20 transition">
                <div class="w-16 h-16 rounded-full bg-brand-600/90 text-white flex items-center justify-center shadow-2xl transform scale-100 group-hover:scale-110 transition">
                  <i id="play-icon" data-lucide="play" class="w-8 h-8 ml-1"></i>
                </div>
              </button>

              <!-- Video Top Info Bar -->
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between text-xs text-white bg-gray-900/80 backdrop-blur-md px-3 py-1.5 rounded-xl opacity-0 group-hover:opacity-100 transition">
                <span class="font-medium">Apex Academy Player &bull; 1080p HD</span>
