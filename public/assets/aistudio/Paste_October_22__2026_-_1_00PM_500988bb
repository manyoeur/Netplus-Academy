      filtered.forEach(course => {
        const isEnrolled = userEnrolled.includes(course.id);
        const card = document.createElement('div');
        card.className = "bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group";
        
