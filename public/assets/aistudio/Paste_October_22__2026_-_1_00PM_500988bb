        `;
        container.prepend(comment);
      }
      input.value = '';
      showToast('Comment posted!');
    }

    // --- AUTHENTICATION MODALS & UTILS ---
    function openAuthModal(mode = 'login') {
      setModalAuthTab(mode);
      const modal = document.getElementById('auth-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeAuthModal() {
      const modal = document.getElementById('auth-modal');
      if (modal) modal.classList.add('hidden');
    }

    function setModalAuthTab(mode) {
      const title = document.getElementById('modal-auth-title');
      const nameField = document.getElementById('modal-field-name');
      const submitBtn = document.getElementById('modal-auth-submit-btn');

      const tabLogin = document.getElementById('modal-tab-login');
      const tabRegister = document.getElementById('modal-tab-register');

      if (mode === 'login') {
        if (title) title.innerText = "Sign In to Apex Academy";
        if (nameField) nameField.classList.add('hidden');
        if (submitBtn) submitBtn.innerText = "Sign In";
        if (tabLogin) tabLogin.className = "flex-1 py-2 text-xs font-bold rounded-lg transition bg-white dark:bg-gray-800 text-gray-900 dark:text-white shadow-sm";
        if (tabRegister) tabRegister.className = "flex-1 py-2 text-xs font-bold rounded-lg transition text-gray-500 dark:text-gray-400";
      } else {
        if (title) title.innerText = "Register Free Account";
        if (nameField) nameField.classList.remove('hidden');
        if (submitBtn) submitBtn.innerText = "Create Account";
        if (tabRegister) tabRegister.className = "flex-1 py-2 text-xs font-bold rounded-lg transition bg-white dark:bg-gray-800 text-gray-900 dark:text-white shadow-sm";
        if (tabLogin) tabLogin.className = "flex-1 py-2 text-xs font-bold rounded-lg transition text-gray-500 dark:text-gray-400";
      }
    }

    function handleModalAuthSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('modal-input-email')?.value || 'user@academy.io';
      const name = document.getElementById('modal-input-name')?.value || 'Alex Rivera';

      currentUser = {
        id: `usr_${Date.now()}`,
        name: name,
        email: email,
        role: 'Pro Student',
        avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=120',
        xp: 250,
        streak: 1,
        studyHours: 1.0,
        enrolledIds: ['c1'],
        certificatesCount: 0
      };

      localStorage.setItem('apex_academy_user', JSON.stringify(currentUser));
      closeAuthModal();
      updateAuthUI();
      renderCourseGrid();
      renderEnrolledCourses();
      showToast('Authenticated successfully!');
    }

    function openForgotPasswordModal() {
      const modal = document.getElementById('forgot-password-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeForgotPasswordModal() {
      const modal = document.getElementById('forgot-password-modal');
      if (modal) modal.classList.add('hidden');
    }

    function handleForgotPassword(e) {
      e.preventDefault();
      const email = document.getElementById('forgot-email-input')?.value || '';
      closeForgotPasswordModal();
      showToast(`Password recovery link sent to ${email}`);
    }

    function showCertificateModal() {
      if (!currentUser) {
        openAuthModal('login');
        return;
      }
      const certUser = document.getElementById('cert-user-name');
      if (certUser) certUser.innerText = currentUser.name;
      const modal = document.getElementById('cert-modal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeCertModal() {
      const modal = document.getElementById('cert-modal');
      if (modal) modal.classList.add('hidden');
    }

    // --- GENERAL TOAST MESSAGES ---
    function showToast(message) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = "toast-animate p-3.5 rounded-2xl bg-gray-900/90 dark:bg-white/90 text-white dark:text-gray-900 border border-gray-700 dark:border-gray-200 text-xs font-semibold shadow-xl flex items-center justify-between gap-3 pointer-events-auto backdrop-blur-md";
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400 dark:text-emerald-600"></i>
          <span>${message}</span>
        </div>
        <button onclick="this.parentElement.remove()" class="opacity-60 hover:opacity-100"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
      `;
      container.appendChild(toast);
      if (window.lucide) lucide.createIcons();
      setTimeout(() => { if (toast.parentElement) toast.remove(); }, 3500);
    }

    // --- VIEW SWITCHER ---
    function switchView(viewName) {
      currentView = viewName;
      const views = ['catalog', 'viewer', 'sandbox', 'dashboard'];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        const navEl = document.getElementById(`nav-${v}`);
        if (el) {
          if (v === viewName) {
            el.classList.remove('hidden');
            if (navEl) navEl.className = "nav-link px-3 py-2 rounded-lg text-sm font-medium transition-colors text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-900/30";
          } else {
            el.classList.add('hidden');
            if (navEl) navEl.className = "nav-link px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-gray-100 dark:hover:bg-gray-700/50";
          }
        }
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // --- CHART INITIALIZATION ---
    function initAnalyticsChart() {
      const chartEl = document.getElementById('studyTimeChart');
      if (!chartEl || typeof Chart === 'undefined') return;
      const ctx = chartEl.getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          datasets: [{
            label: 'Study Hours',
            data: [2.5, 3.0, 1.5, 4.0, 2.0, 1.0, 0.5],
            backgroundColor: '#3b82f6',
            borderRadius: 8,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: { grid: { borderDash: [4, 4] }, ticks: { stepSize: 1 } }
          }
        }
      });
    }

    function setupEventListeners() {
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const closeMobileBtn = document.getElementById('close-mobile-menu');
      const themeBtn = document.getElementById('theme-toggle');

      if (mobileBtn) {
        mobileBtn.addEventListener('click', () => {
          document.getElementById('mobile-menu')?.classList.remove('hidden');
        });
      }
      if (closeMobileBtn) {
        closeMobileBtn.addEventListener('click', closeMobileMenu);
      }
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          document.documentElement.classList.toggle('dark');
        });
      }

      document.addEventListener('click', (e) => {
        const drop = document.getElementById('profile-dropdown');
        const container = document.getElementById('auth-state-container');
        if (drop && !drop.contains(e.target) && container && !container.contains(e.target)) {
          drop.classList.add('hidden');
        }
      });
    }

    function closeMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      if (menu) menu.classList.add('hidden');
    }
  </script>
</body>
</html>