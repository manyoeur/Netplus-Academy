    // --- LAUNCH LESSON VIEWER ---
    function startCourse(courseId) {
      const course = coursesData.find(c => c.id === courseId);
      if (!course) return;

      if (currentUser && currentUser.enrolledIds && !currentUser.enrolledIds.includes(course.id)) {
        currentUser.enrolledIds.push(course.id);
        localStorage.setItem('apex_academy_user', JSON.stringify(currentUser));
        showToast(`Enrolled in ${course.title}!`);
      }

      currentActiveCourse = course;
      if (course.modules && course.modules.length > 0 && course.modules[0].lessons.length > 0) {
        activeLessonObj = course.modules[0].lessons[0];
      }

      const activeCat = document.getElementById('active-course-category');
      const activeTitle = document.getElementById('active-course-title');
      const certTitle = document.getElementById('cert-course-title');

      if (activeCat) activeCat.innerText = course.category;
      if (activeTitle) activeTitle.innerText = course.title;
      if (certTitle) certTitle.innerText = course.title;

      loadActiveLessonContent();
      renderModulesSidebar();
      renderEnrolledCourses();
      switchView('viewer');
    }

    function selectLesson(lessonId) {
      currentActiveCourse.modules.forEach(mod => {
        mod.lessons.forEach(l => {
          if (l.id === lessonId || l.title === lessonId) {
            l.active = true;
            activeLessonObj = l;
          } else {
            l.active = false;
          }
        });
      });
      loadActiveLessonContent();
      renderModulesSidebar();
    }

    function loadActiveLessonContent() {
      if (!activeLessonObj) return;

      const titleEl = document.getElementById('active-lesson-title');
      const readingEl = document.getElementById('active-lesson-reading-content');

      if (titleEl) titleEl.innerText = activeLessonObj.title;
      if (readingEl) readingEl.innerText = activeLessonObj.reading || "Dynamic lesson reading material and documentation.";
      
      const iframe = document.getElementById('video-iframe');
      const thumbWrapper = document.getElementById('video-thumbnail-wrapper');

      if (iframe && thumbWrapper) {
        if (activeLessonObj.videoUrl && activeLessonObj.videoUrl.includes('youtube.com')) {
          iframe.src = activeLessonObj.videoUrl;
          iframe.classList.remove('hidden');
          thumbWrapper.classList.add('hidden');
        } else {
          iframe.classList.add('hidden');
          thumbWrapper.classList.remove('hidden');
        }
      }

      isCurrentLessonCompleted = !!activeLessonObj.completed;
      updateCompletionBtnState();
    }

    // --- MODULE ACCORDION SIDEBAR ---
    function renderModulesSidebar() {
      const list = document.getElementById('modules-list');
      if (!list) return;
      list.innerHTML = '';

      if (!currentActiveCourse || !currentActiveCourse.modules || currentActiveCourse.modules.length === 0) {
        list.innerHTML = `<p class="text-xs text-gray-400 py-4 text-center">No modules created yet for this course.</p>`;
        return;
      }

      currentActiveCourse.modules.forEach((mod) => {
        const modBox = document.createElement('div');
        modBox.className = "border border-gray-200 dark:border-gray-700/80 rounded-xl overflow-hidden";
        
        let lessonsHTML = '';
        mod.lessons.forEach(lesson => {
          lessonsHTML += `
            <div onclick="selectLesson('${lesson.id || lesson.title}')" class="p-2.5 rounded-lg flex items-center justify-between text-xs cursor-pointer transition ${lesson.active ? 'bg-brand-50 dark:bg-brand-900/30 text-brand-600 dark:text-brand-300 font-semibold' : 'hover:bg-gray-100 dark:hover:bg-gray-700/50 text-gray-700 dark:text-gray-300'}">
              <div class="flex items-center gap-2">
                <i data-lucide="${lesson.completed ? 'check-circle' : 'circle'}" class="w-3.5 h-3.5 ${lesson.completed ? 'text-emerald-500 fill-emerald-500/20' : 'text-gray-400'}"></i>
