    function closeQuizModal() {
      document.getElementById('quiz-modal')?.classList.add('hidden');
    }

    function startQuizQuestions() {
      quizCurrentStep = 0;
      quizScore = 0;
      document.getElementById('quiz-intro')?.classList.add('hidden');
      document.getElementById('quiz-active')?.classList.remove('hidden');
      loadQuizQuestion();
    }

    function loadQuizQuestion() {
      const q = activeQuizQuestions[quizCurrentStep];
      const stepInd = document.getElementById('quiz-step-indicator');
      const qText = document.getElementById('quiz-question-text');

      if (stepInd) stepInd.innerText = `Question ${quizCurrentStep + 1} of ${activeQuizQuestions.length}`;
      if (qText) qText.innerText = q.question;
      
      const optionsContainer = document.getElementById('quiz-options-container');
      if (optionsContainer) {
        optionsContainer.innerHTML = '';
        quizSelectedOption = null;

        const nextBtn = document.getElementById('btn-next-question');
        if (nextBtn) nextBtn.disabled = true;

        q.options.forEach((opt, idx) => {
          const btn = document.createElement('button');
          btn.className = "w-full p-3 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-brand-500 text-left text-xs font-medium transition text-gray-800 dark:text-gray-200 flex items-center justify-between";
          btn.innerHTML = `<span>${opt}</span><div class="w-4 h-4 rounded-full border border-gray-400"></div>`;
          btn.onclick = () => selectQuizOption(idx, btn);
          optionsContainer.appendChild(btn);
        });
      }
    }

    function selectQuizOption(idx, element) {
      quizSelectedOption = idx;
      const optionsContainer = document.getElementById('quiz-options-container');
      if (optionsContainer) {
        const allBtns = optionsContainer.children;
        for (let b of allBtns) {
          b.className = "w-full p-3 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-brand-500 text-left text-xs font-medium transition text-gray-800 dark:text-gray-200 flex items-center justify-between";
        }
      }
      element.className = "w-full p-3 rounded-xl border-2 border-brand-500 bg-brand-50/50 dark:bg-brand-900/30 text-left text-xs font-semibold text-brand-600 dark:text-brand-300 flex items-center justify-between";
      const nextBtn = document.getElementById('btn-next-question');
      if (nextBtn) nextBtn.disabled = false;
    }

    function nextQuizQuestion() {
      const q = activeQuizQuestions[quizCurrentStep];
      if (quizSelectedOption === q.answer) quizScore++;

      quizCurrentStep++;
      if (quizCurrentStep < activeQuizQuestions.length) {
        loadQuizQuestion();
      } else {
        document.getElementById('quiz-active')?.classList.add('hidden');
        document.getElementById('quiz-result')?.classList.remove('hidden');
        const pct = Math.round((quizScore / activeQuizQuestions.length) * 100);
        const scoreEl = document.getElementById('quiz-final-score');
        if (scoreEl) scoreEl.innerText = `${pct}%`;
        
        if (currentUser) {
          currentUser.xp = (currentUser.xp || 0) + 150;
          localStorage.setItem('apex_academy_user', JSON.stringify(currentUser));
          updateAuthUI();
        }
      }
    }

