      const grid = document.getElementById('course-grid');
      const levelFilter = document.getElementById('level-filter');
      const levelVal = levelFilter ? levelFilter.value : 'All';
      if (!grid) return;
      grid.innerHTML = '';

      const userEnrolled = currentUser ? (currentUser.enrolledIds || []) : [];
      const isInstructor = currentUser && (currentUser.role.includes('Instructor') || currentUser.role.includes('Admin'));

      const filtered = coursesData.filter(course => {
        const catMatch = currentCategoryFilter === 'All' || course.category === currentCategoryFilter;
        const levelMatch = levelVal === 'All' || course.level === levelVal;
        const searchMatch = !searchQuery || course.title.toLowerCase().includes(searchQuery) || course.category.toLowerCase().includes(searchQuery);
        return catMatch && levelMatch && searchMatch;
      });

      const totalBadge = document.getElementById('total-course-count-badge');
      if (totalBadge) totalBadge.innerText = coursesData.length;

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-500">No courses match your selected filter or search criteria.</div>`;
